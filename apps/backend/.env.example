# ── Base de datos ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/database"

# ── JWT / Auth ─────────────────────────────────────────────────────────────
JWT_SECRET="change-me-64-hex"
JWT_REFRESH_SECRET="change-me-64-hex"

# ── Aislamiento multi-tenant (ver docs/TENANCY.md) ───────────────────────────
# off | warn | enforce.  Default 'warn' (observa sin alterar queries).
# Pasar a 'enforce' tras validar logs para forzar el filtro restaurantId.
TENANT_GUARD_MODE=warn

# ── Stripe · B2B SaaS subscriptions (MRTPVREST → Tenant) ──────────────────
# Cuenta central de MRTPVREST (NO las keys del tenant para cobrar órdenes).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# URLs de retorno tras checkout / portal. Si se omiten se usa FRONTEND_URL.
# STRIPE_CHECKOUT_SUCCESS_URL=https://admin.mrtpvrest.com/billing?status=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://admin.mrtpvrest.com/billing?status=cancel
# STRIPE_BILLING_PORTAL_RETURN_URL=https://admin.mrtpvrest.com/billing

# ── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── MercadoPago (pagos a clientes finales, por-tenant) ─────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ── Frontend público (admin) ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3002

# ── Web Push Notifications ─────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ── Google AI (Gemini) ─────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=

# ── Resend / Correo ────────────────────────────────────────────────────────
RESEND_API_KEY=
SMTP_USER=mrtpvrest@example.com
SMTP_FROM_NAME=MRTPVREST

# ── CORS extra (coma-separado) ─────────────────────────────────────────────
# CORS_ORIGINS=https://preview-1.vercel.app,https://foo.bar

# ── OTA (live-updates del TPV) ─────────────────────────────────────────────
# Token de servicio estático para autorizar POST /api/ota/publish desde CI
# (GitHub Actions). Debe coincidir exactamente con el secret OTA_PUBLISH_TOKEN
# del repo. Genera uno fuerte, p.ej.: openssl rand -hex 32
OTA_PUBLISH_TOKEN=
# Para que el SaaS pueda disparar el workflow de release (POST /api/ota/trigger-build):
# GITHUB_TOKEN=   # PAT con scope workflow
# GITHUB_REPO=colonmbiano/mrtpvrest

# ── Anti-bot del registro self-serve (CAPTCHA Cloudflare Turnstile) ────────
# Secret key de Turnstile. Si se deja vacía, el CAPTCHA se OMITE (dev/test) y
# el registro queda protegido solo por bloqueo de desechables + auto-purga.
# Con la llave puesta, POST /api/auth/register exige y valida el token.
# Crear sitio (gratis): https://dash.cloudflare.com -> Turnstile.
TURNSTILE_SECRET_KEY=

# ── Mesas: barrido de pedidos de QR nunca aceptados ────────────────────────
# Un pedido que entra por el QR de mesa nace en PENDING y ocupa la mesa. Si
# caja nunca lo acepta ni lo cancela, un cron (cada 15 min) lo cancela y libera
# la mesa pasados estos minutos SIN actividad en la cuenta. Nunca toca pedidos
# pagados ni aceptados.
# Esto es el DEFAULT de la instancia: cada restaurante puede poner el suyo
# desde el panel (Tienda → "Liberar mesas automáticamente"), que se guarda en
# RestaurantConfig.tablePendingTtlMin y manda sobre este valor.
# 0 o negativo aquí apaga el barrido para TODOS. Default: 180 (3 h).
# TABLE_PENDING_TTL_MIN=180

# ── QR de mesa: llave para firmar el token del código ──────────────────────
# El QR de cada mesa lleva `?t=<tableId firmado>`: ata el pedido a la mesa real
# (renombrarla no reasigna el papel pegado) y evita que alguien pida a nombre de
# otra mesa editando la URL. Si se deja vacía se usa JWT_SECRET; sin ninguna de
# las dos, el panel cae al QR legacy por número (`?mesa=`), que sigue siendo
# válido. Rotarla invalida los QR ya impresos — hay que reimprimirlos.
# TABLE_QR_SECRET=
